# Copy to .env and fill in. NEVER commit .env. Exposed IBM keys get the hackathon account suspended.
# Bob Shell API key (scope: Inference) used by the reviewer and the Article 14 drafter. Leave empty to run without Bob
# (the console then shows deterministic pre-filter findings and any cached evidence only).
BOB_API_KEY=
# Optional: max Bobcoins one reviewer run may spend
BOB_MAX_COST=0.5
# Shared secret for mutating endpoints (sync, import, review, draft). Send as header X-Origit-Token.
CONSOLE_TOKEN=change-me
# Where bare repos and caches live (inside the container this is /data)
ORIGIT_DATA_DIR=./data
# Public base URL, used in clone/push instructions shown on repo pages
PUBLIC_URL=https://origit.uk
# Host shown in push instructions (display only; the SSH user that actually receives pushes is configured on the box)
GIT_SSH_HOST=git@origit.uk
CONSOLE_READONLY=0
DEMO_ACCOUNT=
